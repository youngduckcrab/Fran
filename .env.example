# ---- 번역 provider ----
# gemini | claude
TRANSLATION_PROVIDER=gemini
# 번역 시 참고할 직전 대화 개수
TRANSLATION_CONTEXT_SIZE=12

# ---- Gemini (기본, 무료 티어) ----
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
# 무료 한도가 가장 넉넉한 쪽이 lite 계열이라 기본값으로 둔다.
# 번역 품질을 올리고 싶으면 gemini-flash-latest 로 바꾸면 된다(한도는 줄어든다).
# 쓸 수 있는 이름 확인: npm run models --workspace=server
GEMINI_MODEL=gemini-flash-lite-latest
# 0 = 사고 끄기(빠르고 할당량 절약), -1 = 자동
GEMINI_THINKING_BUDGET=0
# 애정 표현이 안전 필터에 막히지 않도록 기본은 BLOCK_NONE.
# 계정에서 거부당하면 BLOCK_ONLY_HIGH 로 낮춰보세요.
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

# ---- Claude (유료. TRANSLATION_PROVIDER=claude 일 때만 쓰임) ----
# https://console.anthropic.com 에서 발급. Max 구독과는 별개로 과금됩니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max | off
# Haiku 계열은 이 파라미터를 받지 않아 자동으로 생략됩니다.
CLAUDE_EFFORT=low

# ---- 서버 ----
PORT=8787
DATABASE_PATH=./data/fran.sqlite
# 로그인 토큰 서명용 비밀키: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ---- 사용자 2명 ----
# 각자 로그인할 때 쓸 패스코드. 서로 다르게, 추측하기 어렵게 설정하세요.
USER_A_ID=me
USER_A_NAME=승윤
USER_A_NATIVE_LANG=ko
USER_A_PASSCODE=change-me-a

USER_B_ID=fran
USER_B_NAME=Fran
USER_B_NATIVE_LANG=es
USER_B_PASSCODE=change-me-b
