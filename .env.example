# ---- Claude API ----
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
# 번역에 사용할 모델
TRANSLATION_MODEL=claude-opus-5
# 번역 품질/비용 조절: low | medium | high | xhigh | max
TRANSLATION_EFFORT=low
# 번역 시 참고할 직전 대화 개수
TRANSLATION_CONTEXT_SIZE=12

# ---- 서버 ----
PORT=8787
DATABASE_PATH=./data/fran.sqlite
# 로그인 토큰 서명용 비밀키 (아무 긴 랜덤 문자열)
AUTH_SECRET=change-me-to-a-long-random-string

# ---- 사용자 2명 ----
# 각자 로그인할 때 쓸 패스코드. 서로 다르게, 추측하기 어렵게 설정하세요.
USER_A_ID=me
USER_A_NAME=승윤
USER_A_NATIVE_LANG=ko
USER_A_PASSCODE=change-me-a

USER_B_ID=fran
USER_B_NAME=Fran
USER_B_NATIVE_LANG=es
USER_B_PASSCODE=change-me-b
