# 이 파일을 같은 폴더에 .env 로 복사해서 채운다. .env 는 이 컴퓨터에만 두고 어디에도 올리지 않는다.

# ---- 인터넷 주소 (Tailscale) ----
# login.tailscale.com → Settings → Keys → Generate auth key 로 만든 키.
# 처음 한 번 로그인할 때만 쓰인다.
TS_AUTHKEY=

# 어느 판을 받아 쓸지. 비워 두면 기본 브랜치(latest).
# 아직 합치지 않은 브랜치를 쓰려면 그 이름에서 / 를 - 로 바꿔 적는다. 예: ccr-785538aa-3fa8nv
# FRAN_TAG=

# ---- 서버 (Render 의 Environment 값을 그대로) ----
# 이름도 값도 Render 와 똑같이. 특히 AUTH_SECRET 이 다르면 두 폰 모두 로그아웃된다.
AUTH_SECRET=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
TRANSLATION_PROVIDER=
USER_A_ID=
USER_A_NAME=
USER_A_PASSCODE=
USER_B_ID=
USER_B_NAME=
USER_B_PASSCODE=

# Render 에 이 밖의 값(FIREBASE_SERVICE_ACCOUNT, CLOUDFLARE_TURN_* 등)이 있었다면 아래에 그대로 더한다.
# 전체 목록은 저장소 맨 위의 .env.example.

# ---- 앱 새 판 (저장소를 비공개로 돌릴 때만) ----
# 앱은 새 판이 있는지 이 서버에 묻고, 서버가 GitHub 릴리스에서 APK 를 받아 넘겨준다.
# 저장소가 공개면 비워 둔다. 비공개면 이 저장소 하나에 Contents: Read-only 만 준
# Fine-grained 토큰을 넣는다(docs/home-server.md 의 "저장소를 비공개로").
# APP_RELEASE_TOKEN=
