{
  "name": "fran",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "두 사람을 위한 LLM 맥락 번역 메신저",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace=server",
    "postinstall": "npm run build --workspace=shared",
    "predev": "node scripts/free-ports.mjs 5173 8787 && node scripts/share-port.mjs 5173",
    "free-ports": "node scripts/free-ports.mjs 5173 8787",
    "share": "node scripts/share-port.mjs 5173"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
